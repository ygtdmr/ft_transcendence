# Optional overrides for `make up`. Copy to .env to change them; the defaults work.

# Host port of the ingress (bound to 127.0.0.1 only; HTTPS is the only listener).
INGRESS_PORT=8443

# The single public origin the SPA is served from. It must match the host and port
# a browser uses: the gateways refuse any other Origin, and Auth builds the Google
# redirect URI and avatar URLs from it.
PUBLIC_BASE_URL=https://localhost:8443

# Google sign-in is off unless GOOGLE_CLIENT_ID is set and the client secret is in
# secrets/google_client_secret (a file, so `docker inspect` never shows it; `make up`
# creates it empty). Auth refuses to start with only one of the two. The redirect URI
# is {PUBLIC_BASE_URL}/api/v1/auth/oauth/google/callback. Never commit real values.
GOOGLE_CLIENT_ID=

# The queue Stats consumes Game Session events from. The RabbitMQ topology (#189)
# declares it; this name is a placeholder until then.
STATS_EVENTS_QUEUE=stats.game-events
