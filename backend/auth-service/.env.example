PORT=8080
APP_ENV=development
# Optional overrides; empty values use APP_ENV defaults.
LOG_FORMAT=
LOG_LEVEL=
DATABASE_URL=postgres://auth:change-me-local-only@localhost:5432/auth?sslmode=disable

# Generate a random signing key: openssl rand -base64 32
JWT_SECRET=
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h

# Private listener for /internal/v1 routes. In a deployment set INTERNAL_HOST to
# this container's address on the private network; empty listens on every
# interface (local runs only).
INTERNAL_HOST=
INTERNAL_PORT=8090
# Files holding each caller's service credential (32+ characters, one per
# caller). Leave a caller empty and every private call from it is refused.
# Create one with: openssl rand -hex 32 > <file>
WEB_BFF_CREDENTIAL_FILE=
WEB_BFF_PREVIOUS_CREDENTIAL_FILE=
GAME_GATEWAY_CREDENTIAL_FILE=
GAME_GATEWAY_PREVIOUS_CREDENTIAL_FILE=
NOTIFICATION_GATEWAY_CREDENTIAL_FILE=
NOTIFICATION_GATEWAY_PREVIOUS_CREDENTIAL_FILE=
STATS_SERVICE_CREDENTIAL_FILE=
STATS_SERVICE_PREVIOUS_CREDENTIAL_FILE=
USER_SERVICE_CREDENTIAL_FILE=
USER_SERVICE_PREVIOUS_CREDENTIAL_FILE=

# User Service private listener and Auth's credential for it. Required in
# production; without them new accounts get no User Service profile.
USER_INTERNAL_URL=
USER_SERVICE_OUTBOUND_CREDENTIAL_FILE=
# Upper bound for one provisioning request.
USER_INTERNAL_TIMEOUT=5s

# Game Session private listener and Auth's credential for it. Required in
# production; without them current-session reports no active room and logout
# records no Game departure.
GAME_INTERNAL_URL=
GAME_SERVICE_OUTBOUND_CREDENTIAL_FILE=
# Upper bound for one membership read or session departure request.
GAME_INTERNAL_TIMEOUT=5s

# Private origins of every running Game Gateway and Notification Gateway
# instance (comma-separated) and Auth's credential for each Gateway kind. A
# revoked session's sockets close on every listed instance. Set all four or
# none; required in production. Without them revoked sessions keep their
# open sockets until they reconnect.
GAME_GATEWAY_INTERNAL_URLS=
GAME_GATEWAY_OUTBOUND_CREDENTIAL_FILE=
NOTIFICATION_GATEWAY_INTERNAL_URLS=
NOTIFICATION_GATEWAY_OUTBOUND_CREDENTIAL_FILE=
# Upper bound for one revocation notification.
GATEWAY_INTERNAL_TIMEOUT=5s

# Public route limits as <count>/<duration>; empty uses the default shown.
# Login is limited per client address and per email, registration per client.
LOGIN_CLIENT_RATE_LIMIT=10/1m
LOGIN_EMAIL_RATE_LIMIT=5/1m
REGISTER_CLIENT_RATE_LIMIT=5/10m
# Reverse proxies (addresses or CIDR ranges, comma-separated) whose
# X-Forwarded-For names the client. Set it to the ingress/BFF network in a
# deployment; empty limits by the connection's peer address.
TRUSTED_PROXIES=

# Google sign-in (backend only; never commit real values). Set all three or none.
# PUBLIC_BASE_URL is the external https origin; Google must allow
# {PUBLIC_BASE_URL}/api/v1/auth/oauth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=
