# Game Session reads these at startup. Copy to .env and adjust.
DATABASE_URL=postgres://gamesession:gamesession@localhost:5432/gamesession?sslmode=disable
PORT=8083
# Address of this container on the network it shares with the Web BFF. The public
# routes trust the X-User-Id header and check no credential, so only the BFF may
# connect to this listener. Empty listens on every interface: local runs only.
PUBLIC_HOST=
# Worker tick for countdown, staffing, grace and empty-room deadlines, as a Go duration.
TICK_INTERVAL=1s
# Leave penalty (Bruno, "Leave Penalty"): points = base x role multiplier.
# Leave all three unset to disable penalty records; leave and logout still work.
LEAVE_PENALTY_BASE=1
LEAVE_PENALTY_OPERATIVE_MULTIPLIER=1
LEAVE_PENALTY_SPYMASTER_MULTIPLIER=2
# Private listener for service-to-service calls (/internal/v1/*); never behind the public proxy.
INTERNAL_PORT=8093
# Address of this container on the private network (the private listener binds only
# there, so the reverse proxy cannot reach it). Empty listens on every interface:
# local runs only.
INTERNAL_HOST=
# Each file holds one service credential. Leave unset to accept no internal caller.
AUTH_SERVICE_CREDENTIAL_FILE=
USER_SERVICE_CREDENTIAL_FILE=
GAME_GATEWAY_CREDENTIAL_FILE=
# User Service internal URL and token used by Game Session (Bruno: "Get canonical profile").
USER_SERVICE_INTERNAL_URL=http://127.0.0.1:8091
GAME_TO_USER_SERVICE_CREDENTIAL_FILE=
