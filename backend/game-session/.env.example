# Game Session reads these at startup. Copy to .env and adjust.
DATABASE_URL=postgres://gamesession:gamesession@localhost:5432/gamesession?sslmode=disable
PORT=8083
# Worker tick for countdown, staffing, grace and empty-room deadlines, as a Go duration.
TICK_INTERVAL=1s
# Leave penalty (Bruno, "Leave Penalty"): points = base x role multiplier.
# Leave all three unset to disable penalty records; leave and logout still work.
LEAVE_PENALTY_BASE=1
LEAVE_PENALTY_OPERATIVE_MULTIPLIER=1
LEAVE_PENALTY_SPYMASTER_MULTIPLIER=2
