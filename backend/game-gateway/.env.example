# Game Gateway settings. Placeholders only: never commit real values.
# Secret values live in files (generate each with `openssl rand -hex 32`,
# mode 0400); only their paths go here.

APP_ENV=development
# LOG_FORMAT=json
# LOG_LEVEL=info

# Public listener: GET /ws/v2/rooms/{room_id}, /healthz, /readyz.
PORT=8080
# Private listener: /internal/v1/*. In a deployment set INTERNAL_HOST to this
# container's address on the private network; empty listens on every
# interface (local runs only).
INTERNAL_HOST=
INTERNAL_PORT=8081

# The single public origin the SPA is served from (the same setting Auth uses).
# A handshake from any other origin is refused with a bare 403.
PUBLIC_BASE_URL=https://localhost:8443

# Auth Service session validation (scope session.validate).
AUTH_INTERNAL_URL=http://auth-service:8081
AUTH_SERVICE_OUTBOUND_CREDENTIAL_FILE=/run/secrets/game-gateway-to-auth-service
AUTH_INTERNAL_TIMEOUT=3s

# Game Session room calls (scope room.socket).
GAME_INTERNAL_URL=http://game-session:8081
GAME_SERVICE_OUTBOUND_CREDENTIAL_FILE=/run/secrets/game-gateway-to-game-session
GAME_INTERNAL_TIMEOUT=3s

# Callers of the private listener. A caller without a credential is refused.
# The *_PREVIOUS_* files are set only while a credential is being rotated.
USER_SERVICE_CREDENTIAL_FILE=/run/secrets/user-service-to-game-gateway
# USER_SERVICE_PREVIOUS_CREDENTIAL_FILE=
AUTH_SERVICE_CREDENTIAL_FILE=/run/secrets/auth-service-to-game-gateway
# AUTH_SERVICE_PREVIOUS_CREDENTIAL_FILE=

# Socket bounds.
# SOCKET_SEND_QUEUE=64
# SOCKET_PING_INTERVAL=25s
# SOCKET_PONG_WAIT=60s

# Shutdown.
# SHUTDOWN_TIMEOUT=10s
# SHUTDOWN_DRAIN_DELAY=0s
# SHUTDOWN_CLOSE_TIMEOUT=5s
