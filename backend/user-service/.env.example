PORT=8081
APP_ENV=development
# Optional overrides; empty values use APP_ENV defaults.
LOG_FORMAT=
LOG_LEVEL=
# The service creates and uses its own "users" schema in this database.
DATABASE_URL=postgres://user:change-me-local-only@localhost:5433/user?sslmode=disable
# Private listener for /internal/v1 routes; attach it only to the private network.
INTERNAL_PORT=8091
# Files holding each caller's service credential (32+ characters). Leave empty
# and the service refuses every private call from that caller.
AUTH_SERVICE_CREDENTIAL_FILE=
AUTH_SERVICE_PREVIOUS_CREDENTIAL_FILE=
CHANNEL_SERVICE_CREDENTIAL_FILE=
CHANNEL_SERVICE_PREVIOUS_CREDENTIAL_FILE=
GAME_SESSION_CREDENTIAL_FILE=
GAME_SESSION_PREVIOUS_CREDENTIAL_FILE=
WEB_BFF_CREDENTIAL_FILE=
WEB_BFF_PREVIOUS_CREDENTIAL_FILE=
# Auth's private listener and this service's credential for it. Required in
# production; without them routes that need a signed-in user are not served.
AUTH_INTERNAL_URL=
AUTH_SERVICE_OUTBOUND_CREDENTIAL_FILE=
# Upper bound for one call to Auth, as a Go duration.
AUTH_INTERNAL_TIMEOUT=5s
# Comma-separated private origins of every running Gateway instance and this
# service's credential file per Gateway kind, set together. Required in
# production; without them every user is reported offline.
GAME_GATEWAY_INTERNAL_URLS=
GAME_GATEWAY_OUTBOUND_CREDENTIAL_FILE=
CHAT_GATEWAY_INTERNAL_URLS=
CHAT_GATEWAY_OUTBOUND_CREDENTIAL_FILE=
# Upper bound for one registry query, as a Go duration.
GATEWAY_INTERNAL_TIMEOUT=5s
# Stats' private listener and this service's credential for it. Required in
# production; without them the public profile route is not served.
STATS_INTERNAL_URL=
STATS_SERVICE_OUTBOUND_CREDENTIAL_FILE=
# Upper bound for one call to Stats, as a Go duration.
STATS_INTERNAL_TIMEOUT=5s
# Public https:// origin for avatar URLs; empty gives root-relative URLs.
AVATAR_BASE_URL=
# Absolute directory for uploaded avatars, on a persistent volume. Required in
# production; without it avatar changes are not served.
AVATAR_STORAGE_DIR=
# How long a reporter waits before reporting the same user again, as a Go duration.
REPORT_WINDOW=24h
# Apply embedded migrations at startup. Set to false to skip them.
MIGRATE_ON_START=true
