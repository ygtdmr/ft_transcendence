PORT=8082
APP_ENV=development
# Optional overrides; empty values use APP_ENV defaults.
LOG_FORMAT=
LOG_LEVEL=
# The service creates and uses its own "stats" schema in this database.
DATABASE_URL=postgres://stats:change-me-local-only@localhost:5434/stats?sslmode=disable
# Apply embedded migrations at startup. Set to false to skip them.
MIGRATE_ON_START=true
