PORT=8082
APP_ENV=development
# Optional overrides; empty values use APP_ENV defaults.
LOG_FORMAT=
LOG_LEVEL=
# The service creates and uses its own "stats" schema in this database.
DATABASE_URL=postgres://stats:change-me-local-only@localhost:5434/stats?sslmode=disable
# Apply embedded migrations at startup. Set to false to skip them.
MIGRATE_ON_START=true
# Private listener for /internal/v1 routes; attach it only to the private network.
INTERNAL_PORT=8090
# Files holding User Service's credential for this service (32+ characters).
USER_SERVICE_CREDENTIAL_FILE=
USER_SERVICE_PREVIOUS_CREDENTIAL_FILE=
# Auth's private listener and this service's credential for it. Required in
# production; without them match history is not served.
AUTH_INTERNAL_URL=
AUTH_SERVICE_OUTBOUND_CREDENTIAL_FILE=
# Upper bound for one call to Auth, as a Go duration.
AUTH_INTERNAL_TIMEOUT=5s
