# Web BFF settings. Placeholders only: never commit real values.
# Secret values live in files (generate each with `openssl rand -hex 32`,
# mode 0400); only their paths go here.

APP_ENV=development
# LOG_FORMAT=json
# LOG_LEVEL=info

# Public listener: /api/v1/*, /api/v2/*, /healthz, /readyz. The reverse proxy
# forwards browser REST traffic here; the BFF has no private listener.
PORT=8080

# The single public origin the SPA is served from. Cookie-authenticated writes
# from any other origin are refused with 403 FORBIDDEN_ORIGIN.
PUBLIC_BASE_URL=https://localhost:8443

# Auth Service session validation (scope session.validate).
AUTH_INTERNAL_URL=http://auth-service:8090
AUTH_SERVICE_OUTBOUND_CREDENTIAL_FILE=/run/secrets/web-bff-to-auth-service
AUTH_INTERNAL_TIMEOUT=3s

# Public listeners of the services the BFF forwards to (origin only, no path).
# Expose these only on the service network, never to browsers directly.
AUTH_PUBLIC_URL=http://auth-service:8080
USER_PUBLIC_URL=http://user-service:8080
STATS_PUBLIC_URL=http://stats-service:8080
GAME_PUBLIC_URL=http://game-session:8080
# Upper bound for a service's response headers.
# UPSTREAM_TIMEOUT=10s

# Shutdown.
# SHUTDOWN_TIMEOUT=10s
